\begin{table}[H]
\begin{tabular}{ll}
\toprule
Space group & {{ structure.space_group | tex }} \\
Crystal system & {{ structure.crystal_system | tex }} \\
{% for key, value in structure.cell.items() %}
{{ tex_field_header(structure.cell_latex[key], key | replace("_", " ")) }} & {{ value | tex_number }} \\
