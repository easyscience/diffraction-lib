{% for aniso in structure.atom_site_aniso %}
{{ aniso.label | tex }} & {{ aniso.adp_11 | tex_number }} & {{ aniso.adp_22 | tex_number }} & {{ aniso.adp_33 | tex_number }} & {{ aniso.adp_12 | tex_number }} & {{ aniso.adp_13 | tex_number }} & {{ aniso.adp_23 | tex_number }} \\
{% endfor %}
\bottomrule
\end{tabular}
\end{table}
{% endif %}
{% endfor %}

