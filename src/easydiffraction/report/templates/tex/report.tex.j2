\section{Refinement}

\begin{table}[H]
\edHeaderRows
\begin{tabular}{lS}
\toprule
\multicolumn{1}{l}{Quantity} & \multicolumn{1}{c}{Value} \\
\midrule
Reduced chi-square & {{ refinement.fit_result.reduced_chi_square | tex_number }} \\
Free parameters & {{ refinement.parameters.free | tex_number }} \\
Total parameters & {{ refinement.parameters.total | tex_number }} \\
Constraints & {{ refinement.constraints | tex_number }} \\
R factor & {{ refinement.fit_result.r_factor_all | tex_number }} \\
Weighted R factor & {{ refinement.fit_result.wr_factor_all | tex_number }} \\
